{
  "name": "deers-rock",
  "version": "0.5.0",
  "description": "Healthcare Operating Environment",
  "type": "module",
  "bin": {
    "deers-rock": "./bin/deers-rock.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts up 3000",
    "start": "node dist/cli/index.js up",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --pool=threads --poolOptions.threads.singleThread --sequence.shuffle=false",
    "lint": "tsc --noEmit",
    "verify:facts": "tsx scripts/verify-facts.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikirinjani/Deers-Rock.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "js-yaml": "^5.2.1",
    "marked": "^18.0.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}