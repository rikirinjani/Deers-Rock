# Deer's Rock run configuration (Epic V M5.2).
# Copy to .env (gitignored) and start with:  node --env-file=.env dist/cli/index.js up
# Every variable is optional; the value shown is the default.

# HTTP port for the API and dashboard
PORT=3000
# Bind address; unset = all interfaces. Set 127.0.0.1 behind a reverse proxy.
# BIND_HOST=127.0.0.1
# Directory for world-journal.db and exports/
DATA_DIR=.
# Wall-clock ms between ticks at 1x (minimum 50). The dashboard's 2x/5x divide this.
DR_TICK_MS=1000
# Patient pool size for a fresh world (ignored when resuming from a journal snapshot)
DR_PATIENT_POOL=50
# API key; unset = unauthenticated API (a warning is printed)
# DR_API_KEY=
# Comma-separated allowed CORS origins; unset = any origin
# DR_CORS_ALLOW_ORIGINS=
